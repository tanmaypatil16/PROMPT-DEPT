# Supabase (required for database-backed catalog, auth, admin, and analytics)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only â€” never expose to the browser or NEXT_PUBLIC_* variables
# Prefer SUPABASE_SECRET_KEY; legacy service_role keys can use SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
# After creating the Supabase project, run supabase/RUN_IN_SQL_EDITOR.sql once in
# Dashboard â†’ SQL Editor. URL/keys alone do not create tables.

# Optional analytics tuning
ANALYTICS_RETENTION_DAYS=365
ANALYTICS_RATE_LIMIT_PER_MINUTE=120

# Future AI provider (Prompt Studio / direct tasks) â€” not required for CMS
# AI_PROVIDER_API_KEY=

# Site URL for auth redirects in production
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=